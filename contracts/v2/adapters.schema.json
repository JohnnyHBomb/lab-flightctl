{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightctl.local/contracts/v2/adapters.schema.json",
  "title": "Flightctl site adapters configuration v2 (the 'flip a switch to real lanes' file)",
  "description": "NEW (ADAPTER-PRINCIPLE). Site configuration, not wire format; lives in the site deploy directory, never in the repo (the repo ships config/adapters-v2.json.example). Selects fake | dryrun | real | record per port, sets the site profile (sim | shadow | live) and a mode per lane (off | sim | shadow | live). Semantic fail-closed rules that JSON Schema cannot express are in ADAPTERS.md section 3 and tests/contracts_v2/validation.py adapters_semantics(); startup refuses a config that violates any of them and names the port and lane. Round 2 (Sol 6 B3): command_runner is selected here like every other port; 'features' declares which capabilities are ON, and a port REQUIRED by an enabled feature may not be fake in live (allow_fake cannot override that); every mutating port is lane-scoped, and a shadow lane forces ALL of them to dryrun (a global host-write prohibition for that lane). Amendment 4: rule 7 applies to EFFECTIVE ports: in profile sim a lane override other than fake is refused (a sim site is all fakes; a lane cannot reintroduce a real, dryrun or record port). Amendment 4 rev 2 (Sol 6.1 amd4): rule 6 applies to lane overrides too (a read-only port has no dryrun twin on any lane); a lane in mode sim, in ANY site profile, runs its lane-scoped ports (the lane-critical and the mutating ports) on fakes, inherited site values included; the schema refuses non-fake explicit overrides on a sim lane, and the oracle and startup also check the inherited values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "profile",
    "features",
    "ports",
    "allow_fake",
    "lanes",
    "hosts",
    "roots",
    "wake_profiles",
    "secrets",
    "evidence_dir_ref",
    "tls"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "site_id": {
      "$ref": "common.schema.json#/$defs/short_identifier"
    },
    "profile": {
      "enum": [
        "sim",
        "shadow",
        "live"
      ]
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "command_runner",
        "executor_transport",
        "workload_runner",
        "occupancy_probe",
        "inventory_probe",
        "peer_identity",
        "waker",
        "inhibitor",
        "notifier",
        "model_cache",
        "session_gateway",
        "signer",
        "health_probe",
        "legacy_observer",
        "release_backend"
      ],
      "properties": {
        "clock": {
          "$ref": "#/$defs/impl"
        },
        "executor_transport": {
          "$ref": "#/$defs/impl"
        },
        "workload_runner": {
          "$ref": "#/$defs/impl"
        },
        "occupancy_probe": {
          "$ref": "#/$defs/impl"
        },
        "inventory_probe": {
          "$ref": "#/$defs/impl"
        },
        "peer_identity": {
          "$ref": "#/$defs/impl"
        },
        "waker": {
          "$ref": "#/$defs/impl"
        },
        "inhibitor": {
          "$ref": "#/$defs/impl"
        },
        "notifier": {
          "$ref": "#/$defs/impl"
        },
        "model_cache": {
          "$ref": "#/$defs/impl"
        },
        "session_gateway": {
          "$ref": "#/$defs/impl"
        },
        "signer": {
          "$ref": "#/$defs/impl"
        },
        "health_probe": {
          "$ref": "#/$defs/impl"
        },
        "legacy_observer": {
          "$ref": "#/$defs/impl"
        },
        "release_backend": {
          "$ref": "#/$defs/impl"
        },
        "command_runner": {
          "$ref": "#/$defs/impl"
        }
      }
    },
    "allow_fake": {
      "description": "Ports permitted to stay fake in profile live (e.g. notifier before a channel is configured). Lane-critical ports may never be listed.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "notifier",
          "model_cache",
          "session_gateway",
          "signer",
          "legacy_observer",
          "release_backend",
          "health_probe"
        ]
      }
    },
    "lanes": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/short_identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "enum": [
              "off",
              "sim",
              "shadow",
              "live"
            ]
          },
          "ports": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command_runner": {
                "$ref": "#/$defs/impl"
              },
              "executor_transport": {
                "$ref": "#/$defs/impl"
              },
              "occupancy_probe": {
                "$ref": "#/$defs/impl"
              },
              "workload_runner": {
                "$ref": "#/$defs/impl"
              },
              "inhibitor": {
                "$ref": "#/$defs/impl"
              },
              "waker": {
                "$ref": "#/$defs/impl"
              },
              "model_cache": {
                "$ref": "#/$defs/impl"
              },
              "session_gateway": {
                "$ref": "#/$defs/impl"
              },
              "notifier": {
                "$ref": "#/$defs/impl"
              },
              "release_backend": {
                "$ref": "#/$defs/impl"
              },
              "health_probe": {
                "$ref": "#/$defs/impl"
              }
            }
          },
          "wake_needed": {
            "type": "boolean",
            "default": true,
            "description": "false for lanes on always-on hosts (no waker required)."
          },
          "shadow_since": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/utc_time"
              },
              {
                "type": "null"
              }
            ]
          },
          "legacy_lane": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/short_identifier"
              },
              {
                "type": "null"
              }
            ],
            "description": "Legacy lane name the shadow observer and shim map to this lane."
          },
          "shadow_real": {
            "description": "Round 3 (Sol 6 B1): the ONLY permitted real write on a shadow lane, used for A-ASM step 4 (prove the real inhibitor while legacy lanes.sh still fences the lane). Allowed only with mode shadow and a non-null legacy_lane; never workload, waker or any other port.",
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "inhibitor"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "sim"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "properties": {
                "ports": {
                  "properties": {},
                  "additionalProperties": {
                    "const": "fake"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "hosts": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/short_identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "executor"
        ],
        "properties": {
          "executor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transport",
              "target",
              "key_ref",
              "timeout_s"
            ],
            "properties": {
              "transport": {
                "enum": [
                  "in-process",
                  "local-subprocess",
                  "ssh-forced-command"
                ]
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._@-]{1,253}$"
              },
              "key_ref": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/short_identifier"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              }
            }
          }
        }
      }
    },
    "roots": {
      "description": "Named filesystem roots (model store, cache, scratch, output, deploy, executor state). Absolute paths are site data and appear only here.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/short_identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_id",
          "path"
        ],
        "properties": {
          "host_id": {
            "$ref": "common.schema.json#/$defs/short_identifier"
          },
          "path": {
            "type": "string",
            "pattern": "^(/|~/)[^\\0]{0,1023}$"
          }
        }
      }
    },
    "wake_profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/short_identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "mac",
          "broadcast",
          "port",
          "send_from_host",
          "answer_probe"
        ],
        "properties": {
          "method": {
            "const": "wol"
          },
          "mac": {
            "type": "string",
            "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
          },
          "broadcast": {
            "type": "string",
            "maxLength": 64
          },
          "port": {
            "type": "integer",
            "enum": [
              7,
              9
            ]
          },
          "send_from_host": {
            "$ref": "common.schema.json#/$defs/short_identifier"
          },
          "answer_probe": {
            "enum": [
              "ssh-true",
              "executor-inspect"
            ]
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smtp_ref",
        "slack_ref",
        "approval_keys_ref"
      ],
      "properties": {
        "smtp_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(/|~/)[^\\0]{0,1023}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "slack_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(/|~/)[^\\0]{0,1023}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_keys_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(/|~/)[^\\0]{0,1023}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_dir_ref": {
      "$ref": "common.schema.json#/$defs/short_identifier",
      "description": "Root where onlab conformance runs write dated JSON results (ADAPTERS.md D3)."
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holder_leases",
        "wake",
        "jobs",
        "endpoints",
        "sessions",
        "model_cache",
        "notifications",
        "fido2_approvals",
        "release_backend",
        "shadow_observer",
        "friend_sessions"
      ],
      "properties": {
        "holder_leases": {
          "type": "boolean"
        },
        "wake": {
          "type": "boolean"
        },
        "jobs": {
          "type": "boolean"
        },
        "endpoints": {
          "type": "boolean"
        },
        "sessions": {
          "type": "boolean"
        },
        "model_cache": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "fido2_approvals": {
          "type": "boolean"
        },
        "release_backend": {
          "type": "boolean"
        },
        "shadow_observer": {
          "type": "boolean"
        },
        "friend_sessions": {
          "type": "boolean",
          "default": false,
          "description": "Amendment 1 (owner Q1, 2 Oct 2026: answer (c) for R1). Off by default and OFF in R1. When off, friends get exactly what agents get: API-queued jobs under a per-job DynamicUser; no friend SSH session and no job under a friend's own unix account. The infrastructure for option (a) (per-friend accounts, the C7h helper with claims and quarantine, the session contract, C9) is still specified, built and tested, and is enabled only by turning this on AND, per host, inventory hosts[].friend_sessions_enabled with a recorded c9_proof (rev 7: this global flag never enables any host by itself). 'sessions' may be on only if this is on. Rev 9: changing it from true to false is the authority's fail-closed disable operation (friend work refused at once; every helper copy written false and read back; unreachable hosts disable-pending with no work; the flag is reported off only when no host is pending). Amendment 3: R1 (packet C9w) builds the pathways behind this flag, refusing while it is off; the working bodies (C9) are built after R1, in the session-enablement milestone D."
        }
      },
      "x-required-ports": {
        "holder_leases": [
          "clock",
          "command_runner",
          "executor_transport",
          "occupancy_probe",
          "inventory_probe",
          "peer_identity",
          "inhibitor"
        ],
        "wake": [
          "waker"
        ],
        "jobs": [
          "workload_runner",
          "model_cache"
        ],
        "endpoints": [
          "workload_runner",
          "health_probe",
          "model_cache"
        ],
        "sessions": [
          "session_gateway"
        ],
        "model_cache": [
          "model_cache"
        ],
        "notifications": [
          "notifier"
        ],
        "fido2_approvals": [
          "signer"
        ],
        "release_backend": [
          "release_backend"
        ],
        "shadow_observer": [
          "legacy_observer"
        ],
        "friend_sessions": [
          "session_gateway"
        ]
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "server_name",
        "cert_file",
        "key_file",
        "chain_file",
        "rotation",
        "trust_anchor"
      ],
      "description": "Amendment 1 (owner Q2, 2 Oct 2026): the A7 listener serves a certificate issued by the site's PRIVATE CA, not `tailscale cert` (whose issued names would appear in public certificate-transparency logs). CA-agnostic: a site process (for example a step-ca renewal daemon now, a Vault PKI agent later) writes the files; the authority only reads them, verifies them at start and on change, and reloads without dropping the listener. Peer identity is unchanged: the real socket peer via tailscale whois. Revision 2: verification is against trust_anchor only. Incumbent expiry: if the certificate being served expires and no valid replacement is on disk, the listener STOPS serving TLS (fail closed) and alerts; an expired certificate is never served (tls_listener_action). Revision 3: the incumbent is re-validated under the CURRENT config (server_name, trust_anchor, pins) as well as time; a date-valid certificate that no longer passes is not kept.",
      "properties": {
        "mode": {
          "const": "private-ca"
        },
        "server_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62})(\\.[a-z0-9]([a-z0-9-]{0,62}))+$",
          "description": "DNS name the certificate must cover; it resolves to the controller's tailnet address and is the WebAuthn rp_id (C11b)."
        },
        "cert_file": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{1,255}$"
        },
        "key_file": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{1,255}$",
          "description": "Readable only by the authority's account (checked at start)."
        },
        "chain_file": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{1,255}$",
          "description": "Intermediate chain served with the leaf; the root itself is distributed to client devices (owner action), never served as trust."
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_interval_s",
            "renew_before_s",
            "alert_before_s"
          ],
          "properties": {
            "check_interval_s": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "renew_before_s": {
              "type": "integer",
              "minimum": 3600,
              "description": "Remaining validity at which the site renewer is expected to have replaced the files."
            },
            "alert_before_s": {
              "type": "integer",
              "minimum": 600,
              "description": "Remaining validity at which the authority alerts the operator (must be below renew_before_s)."
            }
          }
        },
        "trust_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_ca_files",
            "pinned_root_sha256"
          ],
          "description": "Amendment 1 rev 2 (Sol 6 amd1): the ONLY roots the served chain may terminate at. The authority refuses any certificate set whose chain is rooted elsewhere (a public or system CA included). If pinned_root_sha256 is non-null the root must also match one pin (SHA-256 of the DER root certificate). The same root files are what the owner distributes to client devices.",
          "properties": {
            "root_ca_files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9._/-]{1,255}$"
              }
            },
            "pinned_root_sha256": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "impl": {
      "enum": [
        "fake",
        "dryrun",
        "real",
        "record"
      ]
    }
  },
