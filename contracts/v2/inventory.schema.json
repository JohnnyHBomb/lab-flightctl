{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightctl.local/contracts/v2/inventory.schema.json",
  "title": "Flightctl inventory v2 (site hardware, static power profile, lane rules)",
  "description": "AMENDS inventory-v1. Adds card binding (uuid, pci_bus_id, numa_node: G07), host roles and a static power profile (G13/G22), an 'asleep' reachability (G22), and per-lane rules (G19). identity_mapping MOVES OUT to accounts (v2). Dynamic power state lives in power.schema.json, never here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "revision",
    "stage",
    "controller",
    "timezone",
    "endpoint_lane_order",
    "hosts",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "site_id": {
      "$ref": "common.schema.json#/$defs/short_identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_id",
        "host_id",
        "endpoint",
        "auth_state"
      ],
      "properties": {
        "controller_id": {
          "$ref": "common.schema.json#/$defs/short_identifier"
        },
        "host_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/short_identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "$ref": "common.schema.json#/$defs/nullable_text"
        },
        "auth_state": {
          "enum": [
            "unresolved",
            "configured"
          ]
        }
      }
    },
    "timezone": {
      "type": "string",
      "pattern": "^(?:UTC|[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+)$"
    },
    "endpoint_lane_order": {
      "description": "Renamed from chat_lane_order: preference order for served endpoints (lowest compute first).",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/short_identifier"
      },
      "uniqueItems": true
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "roles",
        "ssh_endpoint",
        "ssh_user",
        "reachability",
        "observed_at",
        "observation_error",
        "gpu_count",
        "gpu_count_reason",
        "devices",
        "power"
      ],
      "properties": {
        "host_id": {
          "$ref": "common.schema.json#/$defs/short_identifier"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gpu",
              "storage",
              "controller",
              "approver",
              "client"
            ]
          }
        },
        "ssh_endpoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "ssh_user": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "reachability": {
          "description": "Reachability at observation time. 'asleep' = known to be in a sleep state and wakeable; it is never 'free' and never 'unreachable-forever'.",
          "enum": [
            "confirmed",
            "asleep",
            "unreachable",
            "unknown"
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/utc_time"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_count_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          }
        },
        "power": {
          "$ref": "#/$defs/power_profile",
          "description": "Static power profile."
        },
        "ssh_server": {
          "enum": [
            "openssh",
            "tailscale-ssh",
            "none",
            "unknown"
          ],
          "description": "Amendment 1 (Q4): which SSH server answers on the host. 'openssh' = the system sshd, which honours AuthorizedKeysFile; 'tailscale-ssh' = Tailscale SSH, which ignores authorized_keys and authorizes by tailnet ACL. C9 friend sessions may be enabled ONLY on 'openssh' hosts (c9_host_eligible); absent means 'unknown'."
        },
        "friend_sessions_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Amendment 1 rev 7 (Sol 6 amd1 r6): the PER-HOST gate. Friend sessions run on this host only when this AND the global adapters features.friend_sessions are true (friend_session_host_allowed). May be true only on an 'openssh' host with a recorded c9_proof. Absent = false."
        },
        "c9_proof": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proof_id",
                "artefact_sha256",
                "recorded_at",
                "runbook_revision",
                "sshd_verified",
                "probe_login_ok",
                "probe_key_removed",
                "host_id",
                "sshd_host_key_sha256",
                "machine_id_sha256",
                "sshd_effective_sha256",
                "no_conditional_key_settings"
              ],
              "properties": {
                "proof_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
                },
                "artefact_sha256": {
                  "$ref": "common.schema.json#/$defs/sha256",
                  "description": "SHA-256 of the evidence-directory artefact written by runbook step 8."
                },
                "recorded_at": {
                  "$ref": "common.schema.json#/$defs/utc_time"
                },
                "runbook_revision": {
                  "type": "string",
                  "minLength": 1
                },
                "sshd_verified": {
                  "const": true
                },
                "probe_login_ok": {
                  "const": true
                },
                "probe_key_removed": {
                  "const": true
                },
                "host_id": {
                  "$ref": "common.schema.json#/$defs/short_identifier"
                },
                "sshd_host_key_sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "machine_id_sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "sshd_effective_sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "no_conditional_key_settings": {
                  "const": true,
                  "description": "Rev 10 (Sol 6 amd1 r9): sshd_context_problems returned [] on the Include-expanded configuration file set: no authentication-key-relevant directive (SSHD_KEY_RELEVANT) appears in a Match/conditional context."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Amendment 1 rev 7: the C9 pre-enable runbook proof for THIS host (step 8). Null until the runbook has passed here. Rev 8: BOUND to the host (host_id, host key, machine-id and effective sshd -T hashes measured at runbook step 8) and to the stored evidence artefact; a copied, stale or re-imaged-host proof is refused (authority_admits_friend_work). Rev 9: a changed bound setting (global or per-user), a rotated or added host key, a re-image or a new friend account invalidates the proof; the FULL per-host C9 runbook must be re-run (new artefact, proof, inventory observation and helper binding)."
        },
        "sshd_host_key_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amendment 1 rev 8: SHA-256 of the host's sshd host public key, as last OBSERVED by the inventory probe (null = not observed). Admission requires it to equal the c9_proof binding. Rev 9: SHA-256 over the sorted 'type base64' pairs of ALL host public keys named by the effective `sshd -T` hostkey lines (sshd_host_keys_sha256); rotating, adding or removing any host key changes it."
        },
        "machine_id_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amendment 1 rev 8: SHA-256 of /etc/machine-id, as last OBSERVED by the inventory probe (null = not observed). Admission requires it to equal the c9_proof binding."
        },
        "sshd_effective_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amendment 1 rev 8: SHA-256 of the normalised global `sshd -T` output, as last OBSERVED by the inventory probe (null = not observed). Admission requires it to equal the c9_proof binding. Rev 9: sshd_effective_digest over the global `sshd -T` AND `sshd -T -C user=<u>,host=<h>,addr=<a>` for every relevant user (the probe account and every friend account), so a Match User/Group change for a friend account changes it. Rev 10: also covers the Include-expanded configuration FILE SET (path and SHA-256 of contents, in expansion order), so any sshd configuration file change invalidates it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gpu_count": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "gpu_count_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observed_at": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "observation_error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reachability": {
                "const": "asleep"
              }
            }
          },
          "then": {
            "properties": {
              "power": {
                "properties": {
                  "wakeable": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "friend_sessions_enabled": {
                "const": true
              }
            },
            "required": [
              "friend_sessions_enabled"
            ]
          },
          "then": {
            "required": [
              "c9_proof",
              "machine_id_sha256",
              "ssh_server",
              "sshd_effective_sha256",
              "sshd_host_key_sha256"
            ],
            "properties": {
              "ssh_server": {
                "const": "openssh"
              },
              "c9_proof": {
                "type": "object"
              },
              "sshd_host_key_sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "machine_id_sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "sshd_effective_sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "power_profile": {
      "description": "Static, reviewed power facts. The wake mechanism details (MAC, broadcast) live in the site adapters file under wake_profile_ref, never in the repo or the inventory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "wakeable",
        "wake_method",
        "wake_profile_ref",
        "typical_wake_s",
        "wake_timeout_s",
        "sleep_guard",
        "inhibitor_what",
        "linger"
      ],
      "properties": {
        "mode": {
          "enum": [
            "always-on",
            "sleeps"
          ]
        },
        "wakeable": {
          "type": "boolean"
        },
        "wake_method": {
          "enum": [
            "none",
            "wol"
          ]
        },
        "wake_profile_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/short_identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "typical_wake_s": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            {
              "type": "null"
            }
          ]
        },
        "wake_timeout_s": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 180
        },
        "sleep_guard": {
          "type": "boolean"
        },
        "inhibitor_what": {
          "description": "Measured 2 Oct: over non-interactive ssh only an 'idle' block inhibitor is permitted by polkit; the lab sleep guards honour it.",
          "const": "idle"
        },
        "linger": {
          "description": "Whether the executor's user manager survives without a login session. 'required' only if conformance shows the inhibitor or transient units die without it (the owner: enable linger only if needed).",
          "enum": [
            "enabled",
            "not-required",
            "required-missing",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "always-on"
              }
            }
          },
          "then": {
            "properties": {
              "wakeable": {
                "const": false
              },
              "wake_method": {
                "const": "none"
              },
              "wake_profile_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "wake_method": {
                "const": "wol"
              }
            }
          },
          "then": {
            "properties": {
              "wakeable": {
                "const": true
              },
              "wake_profile_ref": {
                "$ref": "common.schema.json#/$defs/short_identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "wakeable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "wake_method": {
                "const": "wol"
              }
            }
          }
        }
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "vendor",
        "model",
        "vram_bytes",
        "driver",
        "uuid",
        "pci_bus_id",
        "numa_node",
        "device_minor",
        "drives_display",
        "unknown_reasons"
      ],
      "properties": {
        "device_id": {
          "$ref": "common.schema.json#/$defs/short_identifier"
        },
        "vendor": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "vram_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "driver": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "uuid": {
          "description": "NVIDIA GPU UUID as printed by nvidia-smi --query-gpu=uuid (e.g. GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx). The occupancy probe filters by this.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^GPU-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pci_bus_id": {
          "description": "Normalised sysfs form: 4-hex-digit domain, lowercase (0000:8d:00.0). nvidia-smi prints an 8-digit uppercase domain (00000000:8D:00.0); the probe normalises.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "numa_node": {
          "description": "From /sys/bus/pci/devices/<pci_bus_id>/numa_node. A sysfs value of -1 maps to null with reason 'no numa affinity reported'.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            {
              "type": "null"
            }
          ]
        },
        "drives_display": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_reasons": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "vendor",
              "model",
              "vram_bytes",
              "driver",
              "uuid",
              "pci_bus_id",
              "numa_node",
              "drives_display",
              "device_minor"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "device_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ],
          "description": "NVIDIA device minor (/dev/nvidia<minor>), from /proc/driver/nvidia/gpus/<bus>/information. Needed for device-cgroup isolation of friend sessions and units (B5)."
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "host_id",
        "device_ids",
        "class",
        "enabled",
        "policy",
        "rules"
      ],
      "properties": {
        "lane_id": {
          "$ref": "common.schema.json#/$defs/short_identifier"
        },
        "host_id": {
          "$ref": "common.schema.json#/$defs/short_identifier"
        },
        "device_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/short_identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "class": {
          "enum": [
            "gpu",
            "cpu"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "../common.schema.json#/$defs/capability_offer"
        },
        "rules": {
          "$ref": "#/$defs/lane_rules"
        }
      }
    },
    "lane_rules": {
      "description": "G19. Enforced lane rules (not capability tags). Quotas per principal live in quota.schema.json; time rules live in window.schema.json.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "class_ceiling",
        "max_lease_s",
        "access_modes",
        "vram_cap_bytes",
        "external_tenant"
      ],
      "properties": {
        "tier": {
          "$ref": "common.schema.json#/$defs/short_identifier"
        },
        "class_ceiling": {
          "description": "Highest class each principal kind may hold on this lane (e.g. agents standby-only on a desktop-shared card). Missing kind = no ceiling beyond policy.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operator": {
              "$ref": "common.schema.json#/$defs/class"
            },
            "human": {
              "$ref": "common.schema.json#/$defs/class"
            },
            "agent": {
              "$ref": "common.schema.json#/$defs/class"
            },
            "service": {
              "$ref": "common.schema.json#/$defs/class"
            }
          }
        },
        "max_lease_s": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "lease",
              "queue",
              "booking",
              "job",
              "session",
              "endpoint"
            ]
          }
        },
        "vram_cap_bytes": {
          "description": "Advisory cap checked by the occupancy probe (exceed -> event + refuse-new); NVIDIA consumer/Turing cards cannot enforce it in hardware.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "external_tenant": {
          "description": "How GPU processes NOT started under a lease are treated (desktop, ComfyUI, Chrome). Legacy flightctl v2 thresholds are the defaults.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "process_noise_mib",
            "lane_noise_mib"
          ],
          "properties": {
            "policy": {
              "enum": [
                "collision",
                "yield"
              ],
              "description": "collision = an unexplained tenant above the noise floor blocks release/grant and raises an event; yield = desktop-shared lane: the tenant has priority, new admissions are refused while it is present and preemptible holders are asked to stop."
            },
            "process_noise_mib": {
              "type": "integer",
              "minimum": 0,
              "default": 512
            },
            "lane_noise_mib": {
              "type": "integer",
              "minimum": 0,
              "default": 1024
            }
          }
        }
      }
    }
  },
  "x-examples": {
    "valid": [
      {
        "schema_version": 2,
        "site_id": "site-a",
        "revision": 3,
        "stage": "confirmed",
        "controller": {
          "controller_id": "controller-a",
          "host_id": "host-0",
          "endpoint": "https://controller-a.example:8790/v2/rpc",
          "auth_state": "configured"
        },
        "timezone": "Europe/London",
        "endpoint_lane_order": [
          "lane-gpu1"
        ],
        "hosts": [
          {
            "host_id": "host-0",
            "roles": [
              "controller",
              "gpu"
            ],
            "ssh_endpoint": "host-0.example",
            "ssh_user": "runner",
            "reachability": "confirmed",
            "observed_at": "2026-10-02T00:00:00Z",
            "observation_error": null,
            "gpu_count": 1,
            "gpu_count_reason": null,
            "devices": [
              {
                "device_id": "gpu-a",
                "vendor": "nvidia",
                "model": "Example GPU",
                "vram_bytes": 25769803776,
                "driver": "600.1",
                "uuid": "GPU-00000000-0000-0000-0000-000000000001",
                "pci_bus_id": "0000:8d:00.0",
                "numa_node": 1,
                "drives_display": false,
                "unknown_reasons": {},
                "device_minor": 0
              }
            ],
            "power": {
              "mode": "always-on",
              "wakeable": false,
