        },
        "error": null
      },
      {
        "schema": 2,
        "request_id": "req-6",
        "status": 503,
        "data": null,
        "error": {
          "code": "unavailable",
          "message": "executor reserve was not accepted",
          "retryable": true,
          "failure_class": "state"
        }
      },
      {
        "schema": 2,
        "request_id": "req-7",
        "status": 202,
        "data": {
          "kind": "pending",
          "operation": "acquire",
          "reason": "waking",
          "retry_after_s": 10,
          "wait_until": "2026-10-02T10:03:00Z",
          "queue_id": null,
          "wake_attempt_id": null
        },
        "error": null
      }
    ]
  }
}
