        "schema": 2,
        "request_id": "req-1",
        "status": 202,
        "data": {
          "kind": "pending",
          "operation": "acquire",
          "reason": "waking",
          "retry_after_s": 10,
          "wait_until": "2026-10-02T10:03:00Z",
          "queue_id": "q-0001",
          "wake_attempt_id": "wake-000013"
        },
        "error": null
      },
      {
        "schema": 2,
        "request_id": "req-2",
