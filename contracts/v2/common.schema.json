{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightctl.local/contracts/v2/common.schema.json",
  "title": "Flightctl contract set v2: common definitions",
  "description": "Shared v2 definitions. Federation hooks (delegation, signed_manifest, capability_offer, transfer/receipt hooks) are NOT redefined here: they stay frozen and dormant in ../common.schema.json and v2 documents reference them there.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    }
  },
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "identifier": {
      "$ref": "../common.schema.json#/$defs/identifier"
    },
    "short_identifier": {
      "$ref": "../common.schema.json#/$defs/short_identifier"
    },
    "sha256": {
      "$ref": "../common.schema.json#/$defs/sha256"
    },
    "utc_time": {
      "$ref": "../common.schema.json#/$defs/utc_time"
    },
    "principal": {
      "$ref": "../common.schema.json#/$defs/principal"
    },
    "lane_ref": {
      "$ref": "../common.schema.json#/$defs/lane_ref"
    },
    "measurement": {
      "$ref": "../common.schema.json#/$defs/measurement"
    },
    "certainty": {
      "$ref": "../common.schema.json#/$defs/certainty"
    },
    "proof": {
      "$ref": "../common.schema.json#/$defs/proof"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "nullable_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "class": {
      "description": "Ownership class, highest first. Order and eviction matrix are decided (plan r4) and unchanged in v2.",
      "enum": [
        "operator",
        "booked",
        "batch",
        "service",
        "resident",
        "standby"
      ]
    },
    "protected_class": {
      "enum": [
        "operator",
        "booked",
        "batch"
      ]
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000
    },
    "positive_duration_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "public_id": {
      "description": "A public, non-secret record id (lease_id, queue_id, job_id, ...). Operators and UIs address records only by these; secrets are never ids.",
      "type": "string",
      "pattern": "^[a-z]{2,10}-[A-Za-z0-9_-]{6,64}$"
    },
    "lease_token": {
      "description": "Holder secret. Two formats: 'urlsafe' (43 chars, default) and 'hex16' (exactly 16 lowercase hex, issued only when the request asks token_format=hex16, for legacy lanes.sh callers). Never appears in reads, events, logs or executor messages.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      ]
    },
    "token_format": {
      "enum": [
        "urlsafe",
        "hex16"
      ]
    },
    "host_boot": {
      "description": "A host's own boot identity as reported by that host (contents of /proc/sys/kernel/random/boot_id on Linux). Used for audit and reboot detection ONLY; never compared across hosts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "boot_id",
        "observed_at"
      ],
      "properties": {
        "host_id": {
          "$ref": "#/$defs/short_identifier"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$|^sim-[A-Za-z0-9._-]{1,64}$"
        },
        "observed_at": {
          "$ref": "#/$defs/utc_time"
        }
      }
    },
    "relative_deadline": {
      "description": "G02 fix. A deadline sent between hosts is a DURATION from the moment the receiver processes the message. The receiver anchors it on its own monotonic clock. The sender's clock fields are audit-only. Round 3 ceiling bound (Sol 6 N1; round 2 overstated it): clock skew cannot bound transport delay, so the AUTHORITY bounds transport on its own monotonic clock. It sends max-end as in_s = approved_max_end - now - margin_s, and on the reply it knows the round trip rtt; the host anchored at most rtt after sending, so host_max_end <= send_time + rtt + in_s. If rtt > margin_s that bound can exceed approved_max_end, and the authority immediately sends a 'ceiling' message (max-end only; the host applies min(existing, new): it can only move EARLIER) computed the same way, repeating until a round trip completes within margin_s; until then the lease is flagged ceiling-unconfirmed and the authority itself enforces approved_max_end. The host's age check (host_utc - sent_at > max_clock_skew_s -> definite clock_skew refusal) is kept only as a stale-message filter, not as the bound. Oracle and the 30 s skew + 60 s transport case: tests/contracts_v2/validation.py host_ceiling_bound(). Round 4: detection is not enough when the correction is lost, so the bound is ENFORCED by admission: no grant until a reply proves authority_receive_time + max_end_remaining_s <= approved_max_end (oracle ceiling_confirmed()).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "in_s",
        "sender_utc"
      ],
      "properties": {
        "kind": {
          "enum": [
            "expiry",
            "max-end",
            "heartbeat-stale",
            "grace"
          ]
        },
        "in_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 31536000
        },
        "sender_utc": {
          "$ref": "#/$defs/utc_time"
        }
      }
    },
    "local_deadline": {
      "description": "A deadline as stored by the host that enforces it: anchored on THAT host's monotonic clock and boot. A different boot_id on read means the host rebooted (reconcile), not that the deadline is foreign.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "boot_id",
        "monotonic_deadline_s",
        "utc_estimate"
      ],
      "properties": {
        "kind": {
          "enum": [
            "expiry",
            "max-end",
            "heartbeat-stale",
            "grace"
          ]
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "monotonic_deadline_s": {
          "type": "number",
          "minimum": 0
        },
        "utc_estimate": {
          "$ref": "#/$defs/utc_time"
        }
      }
    },
    "typed_error": {
      "description": "Preserved failure reason (Grok finding 7). A layer that wraps a lower failure keeps the lower code and message in 'cause'; it never replaces them with a generic string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "layer": {
          "enum": [
            "client",
            "authority",
            "executor",
            "probe",
            "runner",
            "transport",
            "waker",
            "store",
            "notifier",
            "cache",
            "identity"
          ]
        },
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/typed_error"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "error_code": {
      "enum": [
        "invalid",
        "busy",
        "denied",
        "conflict",
        "unknown",
        "unsupported_version",
        "stale_policy",
        "fenced",
        "unavailable",
        "timeout",
        "not_found",
        "quota_exceeded",
        "waking",
        "host_did_not_wake",
        "draining",
        "maintenance",
        "approval_required",
        "identity_mismatch",
        "stale_generation",
        "probe_unknown",
        "probe_failed",
        "cgroup_occupied",
        "gpu_tenant",
        "unit_absent",
        "unit_failed",
        "inhibitor_failed",
        "transport_failed",
        "reply_lost",
        "reply_unparsable",
        "boot_changed",
        "clock_skew",
        "store_corrupt",
        "reconcile_required",
        "token_invalid",
        "principal_disabled",
        "scope_denied",
        "cache_miss",
        "cache_fetch_failed",
        "external_tenant",
        "thermal_limit",
        "adapter_refused",
        "account_busy",
        "replay_unavailable"
      ]
    },
    "token_hint": {
      "description": "First 8 characters of a hex16 lease token. Returned ONLY to the lease's own principal and to operators, for legacy callers that grep 'token XXXXXXXX'. Never present for urlsafe tokens.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "client_label": {
      "description": "Display-only caller label (legacy LANE_OWNER). Never used for authentication, authorisation or quota.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._@:+/-]{1,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "work_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "holder",
            "job",
            "session",
            "endpoint"
          ]
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/public_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "holder"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "job",
                  "session",
                  "endpoint"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "$ref": "#/$defs/public_id"
              }
            }
          }
        }
      ]
    },
    "config_ref": {
      "description": "Reference to a confirmed site document (policy, quotas, accounts, templates, storage, adapters) by id, revision and content hash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/short_identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "x-examples": {
    "valid": [
      {
        "schema_version": 2
      }
    ],
    "invalid": [
      {
        "schema_version": 1
      }
    ]
  }
}
