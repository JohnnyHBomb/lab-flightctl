          "description": "N4: minimum mirrored decisions per path in the clean window before a flip; paths that do not occur naturally are exercised by the gauge through legacy lanes.sh with a dummy holder (legacy stays authoritative).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquire",
            "renew",
            "release",
            "wait",
            "busy",
            "status"
          ],
          "properties": {
            "acquire": {
              "type": "integer",
              "minimum": 1
            },
            "renew": {
              "type": "integer",
              "minimum": 1
            },
            "release": {
              "type": "integer",
              "minimum": 1
            },
            "wait": {
              "type": "integer",
              "minimum": 1
            },
            "busy": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "type": "integer",
              "minimum": 1
            }
          }
