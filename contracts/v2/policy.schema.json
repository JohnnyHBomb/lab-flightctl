{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightctl.local/contracts/v2/policy.schema.json",
  "title": "Flightctl site policy v2",
  "description": "SPLIT from common-v1 policy. Policy is data: every key the authority reads is defined here (Grok finding 6 / G18). Quotas are a separate confirmed document referenced by hash. Decided constants from plan r4 stay const.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "updated_at",
    "purpose_rules",
    "content_rules",
    "timing",
    "lease",
    "quotas",
    "approval_matrix",
    "power",
    "thermal",
    "shadow",
    "security_hooks",
    "work"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "policy_id": {
      "$ref": "common.schema.json#/$defs/short_identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "purpose_rules": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "content_rules": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "timing": {
      "description": "Decided values (plan r4). Unchanged from v1, except max_end_margin_s (added by Amendment 11).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_clock_skew_s",
        "executor_beat_s",
        "protected_stale_s",
        "preemptible_stale_s",
        "grace_service_s",
        "grace_resident_s",
        "grace_standby_s",
        "queue_refresh_s",
        "queue_expiry_s",
        "booking_horizon_s",
        "minimum_booking_s",
        "booking_early_claim_s",
        "booking_checkin_s",
        "booking_warning_s",
        "booking_completion_s",
        "max_end_margin_s"
      ],
      "properties": {
        "max_clock_skew_s": {
          "const": 30
        },
        "executor_beat_s": {
          "const": 60
        },
        "protected_stale_s": {
          "const": 600
        },
        "preemptible_stale_s": {
          "const": 180
        },
        "grace_service_s": {
          "const": 120
        },
        "grace_resident_s": {
          "const": 120
        },
        "grace_standby_s": {
          "const": 300
        },
        "queue_refresh_s": {
          "const": 60
        },
        "queue_expiry_s": {
          "const": 600
        },
        "booking_horizon_s": {
          "const": 1209600
        },
        "minimum_booking_s": {
          "const": 900
        },
        "booking_early_claim_s": {
          "const": 900
        },
        "booking_checkin_s": {
          "const": 900
        },
        "booking_warning_s": {
          "const": 600
        },
        "booking_completion_s": {
          "const": 600
        },
        "max_end_margin_s": {
          "const": 30,
          "description": "Amendment 11 (A5b2 staging, owner's approval 6 Oct 2026): the margin_s of the round-3 ceiling bound (common.schema.json relative_deadline). The authority sends max-end as in_s = approved_max_end - sent_at - max_end_margin_s, in whole seconds rounded down, on reserve and on every shorten-only ceiling. A round trip longer than this margin triggers a ceiling message; without the margin the round-4 grant rule (ceiling_confirmed) never confirms over a wire slower than the rounding slack (measured in A5b2 staging: margin 0 with a 1.5 s delay never confirmed, margin 30 confirmed on the reserve)."
        }
      }
    },
    "lease": {
      "description": "G03/Grok 2. Rolling expiry inside a hard ceiling. Renew sets expiry = min(now + ttl_s, approved_max_end) and SUCCEEDS while now < approved_max_end. Ceiling (round 2, N3): ceiling_s = min(lane rules.max_lease_s, quota_max_lease_s if the principal's effective quota sets max_lease_s else class_ceiling_s[class], absolute_max_s). An explicit quota max_lease_s REPLACES the class default (it may raise it, e.g. a reviewed 12 h unattended workload), but never exceeds the lane cap or absolute_max_s. The requested ttl is never the ceiling. Executable oracle: tests/contracts_v2/validation.py lease_ceiling().",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_ttl_s",
        "class_ceiling_s",
        "renew_mode",
        "holder_heartbeat_s",
        "holder_stale_s",
        "legacy_wait_default_s",
        "client_wait_default_s",
        "absolute_max_s",
        "replay_window_s"
      ],
      "properties": {
        "default_ttl_s": {
          "$ref": "common.schema.json#/$defs/positive_duration_s"
        },
        "class_ceiling_s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "booked",
            "batch",
            "service",
            "resident",
            "standby"
          ],
          "properties": {
            "operator": {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            },
            "booked": {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            },
            "batch": {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            },
            "service": {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            },
            "resident": {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            },
            "standby": {
              "$ref": "common.schema.json#/$defs/positive_duration_s"
            }
          }
        },
        "renew_mode": {
          "const": "rolling-within-ceiling"
        },
        "holder_heartbeat_s": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "holder_stale_s": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800,
          "description": "ACCEPTANCE T05 target: 120 (two missed heartbeats)."
        },
        "legacy_wait_default_s": {
          "const": 7200,
          "description": "lanes.sh wait default 120 min, kept for the legacy shim."
        },
        "client_wait_default_s": {
          "const": 600,
          "description": "New CLI wait default 10 min (P3 brief)."
        },
        "absolute_max_s": {
          "const": 43200,
          "description": "plan r4 operator maximum (12 h)."
        },
        "replay_window_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600,
          "description": "D-token-4 (round 4, Sol 6 r3): raw lease tokens are NEVER stored in the main authority database: leases keep token_sha256 and the idempotency record keeps the response with the token REMOVED. The raw token needed for a same-request replay lives in a separate replay store (its own SQLite file, mode 0600, secure_delete=ON, WAL truncated after each scrub) that is excluded from every backup and scrubbed when this window ends. A backup taken during the window therefore never contains a token. Proof: tests/contracts_v2/test_v2_round4.py (backup taken while a token is live, examined after its deadline; negative control with the round-3 single-file design). Round 5 (Sol 6 r4) crash consistency: a grant commits the replay row FIRST, then the lease and token-free idempotency record in the main DB (source of truth); startup deletes replay rows with no committed idempotency record. Restore: if the main record exists but the replay row does not (main restored from backup, or replay store lost) within the window, the retry gets 409 replay_unavailable (no token, no second grant); the orphaned lease goes through holder-lost handling (stop + emptiness proof) before the lane frees, and the client acquires again with a new request_id. Reference: SplitStore in tests/contracts_v2/validation.py. Round 6 (Sol 6 r5): the token-free replay_deadline is stored in the MAIN idempotency record. A missing replay row is therefore read by the main DB alone: before replay_deadline it means the replay store was lost (409 replay_unavailable + holder-lost); at or after replay_deadline it is the routine scrub and the retry gets the specified grant replay with token null."
        }
      }
    },
    "quotas": {
      "$ref": "common.schema.json#/$defs/config_ref"
    },
    "approval_matrix": {
      "description": "Which override actions need what. the owner 2 Oct: FIDO2 approval for reordering/pre-empting someone else's work only when it is equal priority and being pre-empted. Evaluation: the most specific matching row wins (target-own < target-other < target-other-lower-class|target-other-equal-class|target-other-protected); no matching row = operator+fido2 (fail closed). Default also keeps plan r4's rule that stopping someone else's PROTECTED work with no beneficiary needs a signed approval (decision D-appr-1). Encoded as data so the owner can change it without code.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "when",
          "requires"
        ],
        "properties": {
          "action": {
            "enum": [
              "op-stop",
              "op-extend",
              "op-preempt",
              "queue-reorder",
              "queue-remove-other",
              "booking-cancel-other",
              "booking-displace",
              "quarantine-clear",
              "operator-admission",
              "pipeline",
              "lane-drain",
              "window-set",
              "principal-disable",
              "token-revoke-other",
              "config-activate",
              "host-wake"
            ]
          },
          "when": {
            "enum": [
              "always",
              "target-own",
              "target-other",
              "target-other-equal-class",
              "target-other-lower-class",
              "target-other-protected"
            ]
          },
          "requires": {
            "enum": [
              "none",
              "operator",
              "operator+fido2"
            ]
          }
        }
      }
    },
