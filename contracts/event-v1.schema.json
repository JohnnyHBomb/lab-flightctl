{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightctl.local/contracts/event-v1.schema.json",
  "title": "Flightctl audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "occurred_at", "kind", "state", "request_id", "job_id", "actor", "subject", "site_id", "controller_id", "correlation_id", "lane", "generation", "reason", "data"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "event_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/utc_time" },
    "kind": { "enum": ["acquire", "renew", "release", "claim", "queue", "book", "cancel", "approval-request", "approval", "preempt", "chat-load", "chat-unload", "reconcile", "discovery"] },
    "state": { "enum": ["free", "starting", "running", "stopping", "quarantined", "scheduled", "blocked", "claimed", "missed", "completed", "cancelled", "displaced", "queued", "eligible", "expired", "removed", "loading", "draining", "unloaded", "issued", "approved", "consumed", "revoked", "recovery", "unknown"] },
    "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "job_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "actor": { "$ref": "common.schema.json#/$defs/principal" },
    "subject": { "anyOf": [{ "$ref": "common.schema.json#/$defs/principal" }, { "type": "null" }] },
    "site_id": { "$ref": "common.schema.json#/$defs/short_identifier" },
    "controller_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "correlation_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "lane": { "anyOf": [{ "$ref": "common.schema.json#/$defs/lane_ref" }, { "type": "null" }] },
    "generation": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "booking_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "queue_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "approval_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "job_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "policy_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "manifest_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "token_redacted": { "const": true }
      }
    }
  },
  "x-examples": {
    "valid": [
      { "schema_version": 1, "event_id": "event-a", "occurred_at": "2026-09-27T20:00:00Z", "kind": "acquire", "state": "running", "request_id": "req-a", "job_id": "job-a", "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-a", "lane": { "site_id": "site-a", "host_id": "host-1", "lane_id": "lane-gpu0" }, "generation": 1, "reason": "grant", "data": { "token_redacted": true, "lease_id": "lease-a" } },
      { "schema_version": 1, "event_id": "event-approval-issued", "occurred_at": "2026-09-27T20:00:00Z", "kind": "approval-request", "state": "issued", "request_id": "req-approval", "job_id": null, "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-approval", "lane": null, "generation": null, "reason": "challenge issued", "data": { "approval_id": "approval-a" } },
      { "schema_version": 1, "event_id": "event-approval-approved", "occurred_at": "2026-09-27T20:00:01Z", "kind": "approval", "state": "approved", "request_id": "req-approval", "job_id": null, "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-approval", "lane": null, "generation": null, "reason": "approval verified", "data": { "approval_id": "approval-a" } },
      { "schema_version": 1, "event_id": "event-approval-consumed", "occurred_at": "2026-09-27T20:00:02Z", "kind": "approval", "state": "consumed", "request_id": "req-approval", "job_id": null, "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-approval", "lane": null, "generation": null, "reason": "approval consumed", "data": { "approval_id": "approval-a" } },
      { "schema_version": 1, "event_id": "event-approval-revoked", "occurred_at": "2026-09-27T20:00:03Z", "kind": "approval", "state": "revoked", "request_id": "req-approval", "job_id": null, "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-approval", "lane": null, "generation": null, "reason": "approval revoked", "data": { "approval_id": "approval-a" } },
      { "schema_version": 1, "event_id": "event-booking-recovery", "occurred_at": "2026-09-27T20:00:04Z", "kind": "book", "state": "recovery", "request_id": "req-booking", "job_id": null, "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-booking", "lane": { "site_id": "site-a", "host_id": "host-1", "lane_id": "lane-gpu0" }, "generation": null, "reason": "booking recovery", "data": { "booking_id": "booking-a" } }
    ],
    "invalid": [
      { "schema_version": 1, "event_id": "event-a", "occurred_at": "2026-09-27T20:00:00Z", "kind": "acquire", "state": "running", "request_id": "req-a", "job_id": null, "actor": { "site_id": "site-a", "tenant_id": "tenant-a", "issuer": "issuer-a", "subject": "subject-a" }, "subject": null, "site_id": "site-a", "controller_id": "controller-a", "correlation_id": "corr-a", "lane": null, "generation": null, "reason": "grant", "data": { "token": "secret" } }
    ]
  }
}
