      "response": { "schema": 1, "request_id": "req-cli-9", "status": 200, "data": { "kind": "mutation", "operation": "queue", "record_type": "queue", "record_id": "queue-a", "state": "queued", "revision": 1, "reservation": { "lane": { "site_id": "site-a", "host_id": "host-1", "lane_id": "lane-gpu0" }, "generation": null, "state": "unassigned" } }, "error": null },
