  "negative_cases": [
    {
      "name": "release cannot carry caller generation",
      "expected_rpc": [{ "op": "release", "lane": "lane-gpu0", "args": { "token": "token-abcdefghijklmnop", "generation": 7 } }]
    }
  ],
  "exit_mapping": { "200": 0, "202": 5, "403": 2, "409": 1, "503": 3, "yield": 4 }
