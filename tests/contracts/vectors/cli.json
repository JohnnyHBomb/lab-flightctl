      "argv": ["cancel", "lane-gpu0", "booking-a", "1"],
      "expected_rpc": [{ "op": "cancel", "lane": "lane-gpu0", "args": { "booking_id": "booking-a", "revision": 1 } }],
      "response": { "schema": 1, "request_id": "req-cli-5b", "status": 200, "data": { "kind": "mutation", "operation": "cancel", "record_type": "booking", "record_id": "booking-a", "state": "cancelled", "revision": 2, "reservation": { "lane": { "site_id": "site-a", "host_id": "host-1", "lane_id": "lane-gpu0" }, "generation": null, "state": "released" } }, "error": null },
