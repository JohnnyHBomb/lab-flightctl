{
  "schema_version": 1,
  "defaults": { "ttl_min": 240, "wait_max_min": 10, "lane_source": "argv[1]", "token_enrichment": "server-token-lease-lookup" },
  "cases": [
    {
      "name": "lane-first positional acquire quoted purpose",
      "argv": ["acquire", "lane-gpu0", "quoted purpose", "2"],
      "env": {},
      "expected_rpc": [{ "op": "acquire", "lane": "lane-gpu0", "args": { "purpose": "quoted purpose", "class": "batch", "est_s": 120, "max_s": 120 } }],
      "expected_state": "starting",
