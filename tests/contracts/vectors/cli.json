      "response": { "schema": 1, "request_id": "req-cli-default", "status": 202, "data": { "kind": "pending", "operation": "acquire", "request_id": "req-cli-default", "queue_id": "queue-a", "retry_after_s": 60, "wait_deadline": { "boot_id": "boot-a", "deadline_s": 600, "utc_anchor": "2026-09-27T20:00:00Z", "monotonic_anchor_s": 10 }, "reason": "lane is occupied" }, "error": null },
      "exit": 5
    },
    {
      "name": "bounded wait timeout",
      "argv": ["wait", "lane-gpu0", "quoted purpose", "2", "1"],
      "env": {},
      "expected_rpc": [{ "op": "queue", "lane": "lane-gpu0", "args": { "action": "add", "purpose": "quoted purpose", "class": "batch", "max_wait_s": 60 } }, { "op": "acquire", "lane": "lane-gpu0", "args": { "purpose": "quoted purpose", "class": "batch", "est_s": 120, "max_s": 120, "queue_id": "queue-from-first-result" } }],
      "response": { "schema": 1, "request_id": "req-cli-timeout", "status": 409, "data": null, "error": { "code": "timeout", "message": "bounded wait expired", "retryable": false, "failure_class": "timeout" } },
      "exit": 1
