      "exit": 0
    },
    {
      "name": "lane-first positional release with server generation lookup",
      "argv": ["release", "lane-gpu0", "token-abcdefghijklmnop"],
      "env": {},
      "expected_rpc": [{ "op": "release", "lane": "lane-gpu0", "args": { "token": "token-abcdefghijklmnop" } }],
      "lookup": { "mode": "server-token-lease", "caller_generation_argument": false, "principal_and_lane_checked": true },
      "expected_state": "free",
      "response": { "schema": 1, "request_id": "req-cli-2", "status": 200, "data": { "kind": "mutation", "operation": "release", "record_type": "lease", "record_id": "lease-a", "state": "free", "revision": 2, "reservation": { "lane": { "site_id": "site-a", "host_id": "host-1", "lane_id": "lane-gpu0" }, "generation": 7, "state": "released" } }, "error": null },
      "exit": 0
    },
    {
      "name": "lane-first positional renew TTL minutes to seconds",
      "argv": ["renew", "lane-gpu0", "token-abcdefghijklmnop", "15"],
      "env": {},
      "expected_rpc": [{ "op": "renew", "lane": "lane-gpu0", "args": { "token": "token-abcdefghijklmnop", "extend_s": 900 } }],
      "lookup": { "mode": "server-token-lease", "caller_generation_argument": false, "principal_and_lane_checked": true },
      "response": { "schema": 1, "request_id": "req-cli-3", "status": 409, "data": null, "error": { "code": "conflict", "message": "approved maximum reached", "retryable": false, "failure_class": "conflict" } },
      "exit": 1
    },
    {
      "name": "lane-first wait converts TTL and wait minutes",
      "argv": ["wait", "lane-gpu0", "quoted purpose", "2", "5"],
      "env": {},
      "expected_rpc": [{ "op": "queue", "lane": "lane-gpu0", "args": { "action": "add", "purpose": "quoted purpose", "class": "batch", "max_wait_s": 300 } }, { "op": "acquire", "lane": "lane-gpu0", "args": { "purpose": "quoted purpose", "class": "batch", "est_s": 120, "max_s": 120, "queue_id": "queue-from-first-result" } }],
      "expected_state": "queued",
      "response": { "schema": 1, "request_id": "req-cli-4", "status": 202, "data": { "kind": "pending", "operation": "acquire", "request_id": "req-cli-4", "queue_id": "queue-a", "retry_after_s": 60, "wait_deadline": { "boot_id": "boot-a", "deadline_s": 300, "utc_anchor": "2026-09-27T20:00:00Z", "monotonic_anchor_s": 10 }, "reason": "lane is occupied" }, "error": null },
      "exit": 5
    },
