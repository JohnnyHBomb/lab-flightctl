    "content-policy-current"
  ],
  "timing": {
    "max_clock_skew_s": 30,
    "executor_beat_s": 60,
    "protected_stale_s": 600,
    "preemptible_stale_s": 180,
    "grace_service_s": 120,
    "grace_resident_s": 120,
    "grace_standby_s": 300,
    "queue_refresh_s": 60,
    "queue_expiry_s": 600,
    "booking_horizon_s": 1209600,
    "minimum_booking_s": 900,
    "booking_early_claim_s": 900,
    "booking_checkin_s": 900,
    "booking_warning_s": 600,
    "booking_completion_s": 600
  },
  "lease": {
    "default_ttl_s": 14400,
    "class_ceiling_s": {
      "operator": 43200,
      "booked": 43200,
      "batch": 14400,
      "service": 86400,
      "resident": 86400,
      "standby": 14400
    },
    "renew_mode": "rolling-within-ceiling",
    "holder_heartbeat_s": 60,
    "holder_stale_s": 120,
    "legacy_wait_default_s": 7200,
    "client_wait_default_s": 600,
    "absolute_max_s": 43200,
    "replay_window_s": 3600
  },
  "quotas": {
    "document_id": "quotas",
    "revision": 1,
    "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "approval_matrix": [
    {
      "action": "op-preempt",
      "when": "target-other-equal-class",
      "requires": "operator+fido2"
    },
    {
      "action": "op-preempt",
      "when": "target-other-lower-class",
      "requires": "operator"
    },
    {
      "action": "queue-reorder",
      "when": "target-other-equal-class",
      "requires": "operator+fido2"
    },
    {
      "action": "queue-reorder",
      "when": "target-other-lower-class",
      "requires": "operator"
    },
    {
      "action": "op-stop",
      "when": "target-other-protected",
      "requires": "operator+fido2"
    },
    {
      "action": "op-stop",
      "when": "target-other",
      "requires": "operator"
    },
    {
      "action": "op-extend",
      "when": "target-other",
      "requires": "operator"
    },
    {
      "action": "quarantine-clear",
      "when": "always",
      "requires": "operator"
    },
    {
      "action": "operator-admission",
      "when": "always",
      "requires": "operator+fido2"
    }
  ],
  "power": {
    "wake_on_acquire": true,
    "wake_retry_after_s": 10,
    "wake_rate_limit_s": 60,
    "reads_never_wake": true,
    "quarantine_hold_awake_s": null,
    "quarantine_realert_s": 21600
  },
  "thermal": [
    {
      "tier": "pair-24g",
      "max_temp_c": 88,
      "act": "refuse-new"
    }
  ],
  "shadow": {
    "clean_days_required": 3,
    "divergence_classes_blocking": [
      "grant-mismatch",
      "holder-mismatch",
      "release-mismatch",
      "occupancy-mismatch",
      "would-quarantine",
      "adapter-error"
    ],
    "min_path_counts": {
      "acquire": 10,
      "renew": 5,
      "release": 10,
      "wait": 3,
      "busy": 3,
      "status": 20
    },
    "mirror_errors_block": true
  },
  "security_hooks": {
    "supported_schemes": [
      "ssh-sk",
      "webauthn"
    ],
    "unsupported_supplied_action": "deny"
  },
  "work": {
    "max_active_parents_per_human_per_host": 1,
    "children_share_parent_slot": true
  }
